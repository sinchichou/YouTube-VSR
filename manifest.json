{
  "manifest_version": 3,
  "name": "YouTube VSR",
  "version": "1.0",
  "description": "即時擷取並處理 YouTube 影片影格。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.twitch.tv/*"
      ],
      "resources": [
        "wgfx/parser.js",
        "effects_wgsl/*.wgsl"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}